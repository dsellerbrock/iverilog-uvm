(DELAYFILE
  (SDFVERSION "3.0")
  (DESIGN "top")
  (TIMESCALE 1ns)
  (CELL
    (CELLTYPE "tc")
    (INSTANCE u1)
    (TIMINGCHECK
      (SETUP d (posedge clk) (2))
      (HOLD d (posedge clk) (3))
      (SETUPHOLD d (negedge clk) (4) (5))
      (RECOVERY (posedge rst) (posedge clk) (6))
      (REMOVAL (posedge rst) (posedge clk) (7))
      (SKEW (posedge clk) (posedge d) (8))
      (BIDIRECTSKEW (posedge clk) (posedge d) (9) (10))
      (WIDTH (posedge clk) (11))
      (PERIOD (posedge clk) (12))
      (NOCHANGE (posedge clk) d (0) (0))
      (SETUP b[1] (posedge clk) (13))
      (SETUP d (COND en (posedge clk)) (14))
      (SETUP d (COND !en (posedge clk)) (15))
    )
  )
)
