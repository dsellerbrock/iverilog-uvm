# IEEE 1800-2017 compilation units without module roots
sv_rootless_compilation_unit normal,-g2012 ivltests gold=sv_rootless_compilation_unit.gold
sv_empty_compilation_unit normal,-g2012 ivltests gold=sv_empty_compilation_unit.gold
sv_rootless_compilation_unit_fail CE,-g2012 ivltests gold=sv_rootless_compilation_unit_fail.gold
sv_rootless_randsequence_undeclared_fail CE,-g2012 ivltests gold=sv_rootless_randsequence_undeclared_fail.gold
sv_rootless_extern_constraint_missing_fail CE,-g2012 ivltests gold=sv_rootless_extern_constraint_missing_fail.gold
sv_rootless_explicit_top_fail CE,-g2012,-s,missing_root ivltests gold=sv_rootless_explicit_top_fail.gold
sv_rootless_verilog_fail CE,-g2005 ivltests gold=sv_rootless_verilog_fail.gold
