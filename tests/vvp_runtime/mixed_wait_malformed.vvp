:ivl_version "13.0 (devel)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
S_top .scope module, "top" "top" 1 1;
 .timescale 0 0;
E_0 .event "event";
    .scope S_top;
T_0 ;
    %event/expr/return;
    %event/expr/load/v 0, 0;
    %wait/obj/expr E_0;
    %event/expr/load/v 0;
    %end;
    .thread T_0;
:file_names 2;
    "N/A";
    "mixed_wait_malformed.vvp";
