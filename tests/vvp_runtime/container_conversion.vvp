:ivl_version "13.0 (devel)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
S_unit .scope package, "$unit" "$unit" 1 1;
 .timescale 0 0;
S_top .scope module, "top" "top" 1 1;
 .timescale 0 0;
C_typed_handle .class "typed_handle" "top.typed_handle" [1]
   0: "value", "q0:sb32"
 ;
C_typed_proto .class/struct "" [1]
   0: "value", "q0:sb32"
 ;
v_typed_int_source .var/queue "typed_int_source", 1+, "Qo";
v_typed_int_target .var/queue "typed_int_target", 1+, "Qo";
v_typed_x_source .var/queue "typed_x_source", 1, "Qo";
v_typed_x_target .var/queue "typed_x_target", 1, "Qo";
v_typed_handle .var/cobj "typed_handle_value", TC_typed_handle;
v_typed_handle_source .var/queue "typed_handle_source", 1, "Qo";
v_typed_handle_target .var/queue "typed_handle_target", 1, "Qo";
v_typed_proto_value .var/cobj "typed_proto_value", C_typed_proto;
v_typed_proto_source .var/queue "typed_proto_source", 1, "Qo";
v_typed_proto_queue .var/queue "typed_proto_queue", 1, "Qo";
v_typed_proto_darray .var/queue "typed_proto_darray", 1, "Qo";
v_typed_fallback_source .var/queue "typed_fallback_source", 1, "Qo";
v_typed_fallback_target .var/queue "typed_fallback_target", 1, "Qo";
    .scope S_top;
T_0 ;
    %ix/load 0, 3, 0;
    %new/darray 0, "v8";
    %ix/load 1, 0, 0;
    %pushi/vec4 151, 50, 8;
    %set/dar/obj/vec4 1;
    %pop/vec4 1;
    %ix/load 1, 1, 0;
    %pushi/vec4 60, 0, 8;
    %set/dar/obj/vec4 1;
    %pop/vec4 1;
    %ix/load 1, 2, 0;
    %pushi/vec4 119, 0, 8;
    %set/dar/obj/vec4 1;
    %pop/vec4 1;

    %container/to/queue "b8", 2;
    %dup/obj/ref;
    %qsize/o;
    %cmpi/ne 2, 0, 32;
    %jmp/1 T_bad, 4;
    %dup/obj/ref;
    %ix/load 3, 0, 0;
    %flag_set/imm 4, 0;
    %load/qo/v 8;
    %cmpi/ne 133, 0, 8;
    %jmp/1 T_bad, 4;
    %dup/obj/ref;
    %pushi/vec4 90, 0, 8;
    %store/qo/b/v 8;
    %dup/obj/ref;
    %qsize/o;
    %cmpi/ne 3, 0, 32;
    %jmp/1 T_bad, 4;

    %queue/to/darray "v8";
    %queue/to/darray "v8";
    %dup/obj/ref;
    %qsize/o;
    %cmpi/ne 3, 0, 32;
    %jmp/1 T_bad, 4;
    %dup/obj/ref;
    %ix/load 3, 0, 0;
    %flag_set/imm 4, 0;
    %load/qo/v 8;
    %cmpi/ne 133, 0, 8;
    %jmp/1 T_bad, 4;
    %dup/obj/ref;
    %ix/load 3, 1, 0;
    %flag_set/imm 4, 0;
    %load/qo/v 8;
    %cmpi/ne 60, 0, 8;
    %jmp/1 T_bad, 4;
    %dup/obj/ref;
    %ix/load 3, 2, 0;
    %flag_set/imm 4, 0;
    %load/qo/v 8;
    %cmpi/ne 90, 0, 8;
    %jmp/1 T_bad, 4;

    %pop/obj 1, 0;

; A bounded destination queue is materialized once per outer source element.
    %ix/load 4, 0, 0;
    %new/queue "sb32";
    %dup/obj/ref;
    %pushi/vec4 1, 0, 32;
    %store/qo/b/v 32;
    %dup/obj/ref;
    %pushi/vec4 2, 0, 32;
    %store/qo/b/v 32;
    %dup/obj/ref;
    %pushi/vec4 3, 0, 32;
    %store/qo/b/v 32;
    %store/qb/obj v_typed_int_source, 4;
    %ix/load 4, 0, 0;
    %new/queue "o";
    %dup/obj/ref;
    %load/obj v_typed_int_source;
    %append/qo/obj/queue "sb32", 2;
    %store/qobj/obj v_typed_int_target, 4;
    %qsize v_typed_int_target;
    %cmpi/ne 1, 0, 32;
    %jmp/1 T_bad, 4;
    %ix/load 3, 0, 0;
    %flag_set/imm 4, 0;
    %load/dar/obj v_typed_int_target;
    %qsize/o;
    %cmpi/ne 2, 0, 32;
    %jmp/1 T_bad, 4;
    %ix/load 3, 0, 0;
    %flag_set/imm 4, 0;
    %load/dar/obj v_typed_int_target;
    %ix/load 3, 0, 0;
    %flag_set/imm 4, 0;
    %load/qo/v 32;
    %cmpi/ne 1, 0, 32;
    %jmp/1 T_bad, 4;
    %ix/load 3, 0, 0;
    %flag_set/imm 4, 0;
    %load/dar/obj v_typed_int_target;
    %ix/load 3, 1, 0;
    %flag_set/imm 4, 0;
    %load/qo/v 32;
    %cmpi/ne 2, 0, 32;
    %jmp/1 T_bad, 4;
    %load/obj v_typed_int_source;
    %ix/load 3, 0, 0;
    %flag_set/imm 4, 0;
    %qdar/loadlv/o "@0";
    %pushi/vec4 99, 0, 32;
    %ix/load 3, 0, 0;
    %flag_set/imm 4, 0;
    %store/qo/i/v 32;
    %ix/load 3, 0, 0;
    %flag_set/imm 4, 0;
    %load/dar/obj v_typed_int_target;
    %ix/load 3, 0, 0;
    %flag_set/imm 4, 0;
    %load/qo/v 32;
    %cmpi/ne 1, 0, 32;
    %jmp/1 T_bad, 4;

; A 4-state source becomes a fresh 2-state dynamic array (X/Z map to zero).
    %ix/load 0, 1, 0;
    %new/darray 0, "v4";
    %ix/load 1, 0, 0;
    %pushi/vec4 12, 5, 4;
    %set/dar/obj/vec4 1;
    %pop/vec4 1;
    %ix/load 4, 0, 0;
    %store/qb/obj v_typed_x_source, 4;
    %ix/load 4, 0, 0;
    %new/queue "o";
    %dup/obj/ref;
    %load/obj v_typed_x_source;
    %append/qo/obj/darray "b4";
    %store/qobj/obj v_typed_x_target, 4;
    %ix/load 3, 0, 0;
    %flag_set/imm 4, 0;
    %load/dar/obj v_typed_x_target;
    %ix/load 3, 0, 0;
    %flag_set/imm 4, 0;
    %load/qo/v 4;
    %cmpi/ne 8, 0, 4;
    %jmp/1 T_bad, 4;
    %load/obj v_typed_x_source;
    %ix/load 3, 0, 0;
    %flag_set/imm 4, 0;
    %load/qo/obj;
    %pushi/vec4 1, 0, 4;
    %ix/load 3, 0, 0;
    %flag_set/imm 4, 0;
    %store/qo/i/v 4;
    %ix/load 3, 0, 0;
    %flag_set/imm 4, 0;
    %load/dar/obj v_typed_x_target;
    %ix/load 3, 0, 0;
    %flag_set/imm 4, 0;
    %load/qo/v 4;
    %cmpi/ne 8, 0, 4;
    %jmp/1 T_bad, 4;

; Class elements retain handle identity while the inner queue is fresh.
    %new/cobj C_typed_handle;
    %store/obj v_typed_handle;
    %load/obj v_typed_handle;
    %pushi/vec4 7, 0, 32;
    %store/prop/v 0, 32;
    %pop/obj 1, 0;
    %ix/load 4, 0, 0;
    %new/queue "o";
    %dup/obj/ref;
    %load/obj v_typed_handle;
    %store/qo/b/obj;
    %store/qb/obj v_typed_handle_source, 4;
    %ix/load 4, 0, 0;
    %new/queue "o";
    %dup/obj/ref;
    %load/obj v_typed_handle_source;
    %append/qo/obj/queue "o", 0;
    %store/qobj/obj v_typed_handle_target, 4;
    %load/obj v_typed_handle;
    %pushi/vec4 9, 0, 32;
    %store/prop/v 0, 32;
    %pop/obj 1, 0;
    %ix/load 3, 0, 0;
    %flag_set/imm 4, 0;
    %load/dar/obj v_typed_handle_target;
    %ix/load 3, 0, 0;
    %flag_set/imm 4, 0;
    %load/qo/obj;
    %test_nul/obj;
    %jmp/1 T_bad, 4;
    %prop/v 0;
    %pop/obj 1, 0;
    %cmpi/ne 9, 0, 32;
    %jmp/1 T_bad, 4;

; Both prototype forms copy an unpacked-struct value independently.
    %new/cobj C_typed_proto;
    %store/obj v_typed_proto_value;
    %load/obj v_typed_proto_value;
    %pushi/vec4 7, 0, 32;
    %store/prop/v 0, 32;
    %pop/obj 1, 0;
    %ix/load 4, 0, 0;
    %new/queue "o";
    %dup/obj/ref;
    %load/obj v_typed_proto_value;
    %store/qo/b/obj;
    %store/qb/obj v_typed_proto_source, 4;
    %ix/load 4, 0, 0;
    %new/queue "o";
    %dup/obj/ref;
    %load/obj v_typed_proto_source;
    %append/qo/obj/queue/proto "o", 0, C_typed_proto;
    %store/qobj/obj v_typed_proto_queue, 4;
    %ix/load 4, 0, 0;
    %new/queue "o";
    %dup/obj/ref;
    %load/obj v_typed_proto_source;
    %append/qo/obj/darray/proto "o", C_typed_proto;
    %store/qobj/obj v_typed_proto_darray, 4;
    %ix/load 3, 0, 0;
    %flag_set/imm 4, 0;
    %load/dar/obj v_typed_proto_source;
    %ix/load 3, 0, 0;
    %flag_set/imm 4, 0;
    %load/qo/obj;
    %test_nul/obj;
    %jmp/1 T_bad, 4;
    %pushi/vec4 9, 0, 32;
    %store/prop/v 0, 32;
    %pop/obj 1, 0;
    %ix/load 3, 0, 0;
    %flag_set/imm 4, 0;
    %load/dar/obj v_typed_proto_queue;
    %ix/load 3, 0, 0;
    %flag_set/imm 4, 0;
    %load/qo/obj;
    %test_nul/obj;
    %jmp/1 T_bad, 4;
    %prop/v 0;
    %pop/obj 1, 0;
    %cmpi/ne 7, 0, 32;
    %jmp/1 T_bad, 4;
    %ix/load 3, 0, 0;
    %flag_set/imm 4, 0;
    %load/dar/obj v_typed_proto_darray;
    %ix/load 3, 0, 0;
    %flag_set/imm 4, 0;
    %load/qo/obj;
    %test_nul/obj;
    %jmp/1 T_bad, 4;
    %prop/v 0;
    %pop/obj 1, 0;
    %cmpi/ne 7, 0, 32;
    %jmp/1 T_bad, 4;

; Nil is quiet but materialized; a non-container warns and is also empty.
    %ix/load 4, 0, 0;
    %null;
    %store/qb/obj v_typed_fallback_source, 4;
    %ix/load 4, 0, 0;
    %load/obj v_typed_handle;
    %store/qb/obj v_typed_fallback_source, 4;
    %ix/load 4, 0, 0;
    %new/queue "o";
    %dup/obj/ref;
    %load/obj v_typed_fallback_source;
    %append/qo/obj/queue "sb32", 0;
    %store/qobj/obj v_typed_fallback_target, 4;
    %qsize v_typed_fallback_target;
    %cmpi/ne 2, 0, 32;
    %jmp/1 T_bad, 4;
    %ix/load 3, 0, 0;
    %flag_set/imm 4, 0;
    %load/dar/obj v_typed_fallback_target;
    %test_nul/obj;
    %jmp/1 T_bad, 4;
    %qsize/o;
    %cmpi/ne 0, 0, 32;
    %jmp/1 T_bad, 4;
    %ix/load 3, 1, 0;
    %flag_set/imm 4, 0;
    %load/dar/obj v_typed_fallback_target;
    %test_nul/obj;
    %jmp/1 T_bad, 4;
    %qsize/o;
    %cmpi/ne 0, 0, 32;
    %jmp/1 T_bad, 4;

    %vpi_call/w 1 2 "$display", "PASSED" {0 0 0 0};
    %end;
T_bad ;
    %vpi_call/w 1 1 "$fatal", 32'sb00000000000000000000000000000001, "container conversion failed" {0 0 0 0};
    %end;
    .thread T_0;
:file_names 2;
    "N/A";
    "tests/vvp_runtime/container_conversion.vvp";
