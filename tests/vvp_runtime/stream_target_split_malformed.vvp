:ivl_version "13.0 (devel)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
S_unit .scope package, "$unit" "$unit" 1 1;
 .timescale 0 0;
S_top .scope module, "top" "top" 1 1;
 .timescale 0 0;
    .scope S_top;
T_0 ;
    %stream/pad/min 8;
    %end;
    .thread T_0;
T_1 ;
    %pushi/vec4 0, 0, 4;
    %stream/split/rem 8;
    %end;
    .thread T_1;
T_2 ;
    %pushi/vec4 0, 0, 4;
    %split/vec4 8;
    %end;
    .thread T_2;
T_3 ;
    %pushi/vec4 165, 0, 8;
    %split/vec4 8;
    %pop/vec4 2;
    %end;
    .thread T_3;
:file_names 2;
    "N/A";
    "stream_target_split_malformed.vvp";
