:ivl_version "13.0 (devel)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
S_unit .scope package, "$unit" "$unit" 1 1;
 .timescale 0 0;
S_top .scope module, "top" "top" 1 1;
 .timescale 0 0;
    .scope S_top;
RS_bad_formals .ufunc/resolv/vec4 TD_missing, 8, D_missing (P0, P1) S_top;
RS_zero_width .ufunc/resolv/vec4 TD_missing, 0, D_missing (P0) S_top;
:file_names 2;
    "N/A";
    "tests/vvp_runtime/ufunc_resolver_malformed.vvp";
