:ivl_version "13.0 (devel)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
S_unit .scope package, "$unit" "$unit" 1 1;
 .timescale 0 0;
S_top .scope module, "top" "top" 1 1;
 .timescale 0 0;
    .scope S_top;
T_0 ;
    %fill/dar/obj/vec4;
    %fill/dar/obj/real;
    %fill/dar/obj/str;
    %fill/dar/obj/obj;
    %pushi/vec4 1, 0, 1;
    %null;
    %fill/dar/obj/vec4;
    %pop/obj 1, 0;
    %pop/vec4 1;
    %null;
    %null;
    %fill/dar/obj/obj;
    %pop/obj 2, 0;
    %ix/load 0, 1, 0;
    %new/darray 0, "v4";
    %pushi/vec4 1, 0, 1;
    %fill/dar/obj/vec4;
    %pop/vec4 1;
    %pop/obj 1, 0;
    %ix/load 0, 1, 0;
    %new/darray 0, "b4";
    %pushi/vec4 1, 0, 1;
    %fill/dar/obj/vec4;
    %pop/vec4 1;
    %pop/obj 1, 0;
    %end;
    .thread T_0;
:file_names 2;
    "N/A";
    "darray_default_fill_malformed.vvp";
