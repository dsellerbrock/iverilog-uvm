:ivl_version "13.0 (devel)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
S_top .scope module, "top" "top" 1 1;
 .timescale 0 0;
v_mem .array "mem", 0 0, 15 0;
v_source .var "source", 7 0;
v_index .var/2s "index", 63 0;
    .scope S_top;
T_0 ;
    %pushi/vec4 23205, 0, 16;
    %ix/load 4, 0, 0;
    %flag_set/imm 4, 0;
    %store/vec4a v_mem, 4, 0;
    %pushi/vec4 60, 0, 8;
    %store/vec4 v_source, 0, 8;

    %pushi/vec4 2147483648, 0, 32;
    %concati/vec4 0, 0, 32;
    %store/vec4 v_index, 0, 64;
    %load/vec4 v_source;
    %ix/getv/s 4, v_index;
    %flag_set/imm 4, 0;
    %ix/load 3, 0, 0;
    %force/vec4/a v_mem, 4;
    %force/link/a v_mem, v_source;
    %delay 0, 0;
    %vpi_call/w 1 1 "$display", "min-force=%h", &A<v_mem, 0> {0 0 0 0};
    %ix/getv/s 4, v_index;
    %ix/load 5, 8, 0;
    %flag_set/imm 4, 0;
    %ix/load 3, 0, 0;
    %release/reg/a v_mem, 4, 5;
    %vpi_call/w 1 1 "$display", "min-release=%h", &A<v_mem, 0> {0 0 0 0};

    %pushi/vec4 4294967295, 0, 33;
    %concati/vec4 2147483647, 0, 31;
    %store/vec4 v_index, 0, 64;
    %load/vec4 v_source;
    %ix/getv/s 4, v_index;
    %flag_set/imm 4, 0;
    %ix/load 3, 0, 0;
    %force/vec4/a v_mem, 4;
    %force/link/a v_mem, v_source;
    %delay 0, 0;
    %vpi_call/w 1 1 "$display", "max-force=%h", &A<v_mem, 0> {0 0 0 0};
    %ix/getv/s 4, v_index;
    %ix/load 5, 8, 0;
    %flag_set/imm 4, 0;
    %ix/load 3, 0, 0;
    %release/reg/a v_mem, 4, 5;
    %vpi_call/w 1 1 "$display", "max-release=%h", &A<v_mem, 0> {0 0 0 0};
    %end;
    .thread T_0;
:file_names 2;
    "N/A";
    "force_array_extreme_offset.vvp";
