:ivl_version "13.0 (devel)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
S_unit .scope package, "$unit" "$unit" 1 1;
 .timescale 0 0;
S_top .scope module, "top" "top" 1 1;
 .timescale 0 0;
v_key .var/2s "key", 7 0;
v_map .var/queue "map", 1, "MS";
v_rc .var/2s "rc", 31 0;
    .scope S_top;
T_0 ;
    %ix/load 4, 0, 0;
    %pushi/vec4 1000, 0, 32;
    %load/obj v_map;
    %pushi/str "value";
    %aa/store/str/v;
    %pop/obj 1, 0;
    %aa/first/sig/sv v_map, v_key;
    %pad/u 32;
    %store/vec4 v_rc, 0, 32;
    %vpi_call/w 1 1 "$display", "rc=%0d key=%h", v_rc, v_key {0 0 0 0};
    %end;
    .thread T_0;
:file_names 2;
    "N/A";
    "assoc_traversal_key_width.vvp";
