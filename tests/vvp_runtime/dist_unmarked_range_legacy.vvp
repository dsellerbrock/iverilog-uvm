:ivl_version "13.0 (devel)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
S_dist_unit .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
C_dist_class .class "c" "$unit.c" [1]
   0: "a", "q8:rb3"
 .constraint "dc" "(dist (add p:0:3 c:0:32:s) (b c:1:32:s [c:0:32:s,c:3:32:s]) (b c:4:32:s c:4:32:s))"
 ;
S_dist_class .scope class, "c" "c" 3 1, 3 1 0, S_dist_unit;
 .timescale 0 0;
S_dist_main .scope module, "main" "main" 3 5;
 .timescale 0 0;
v_dist_four .var/2s "four_count", 31 0;
v_dist_range .var/2s "range_count", 31 0;
v_dist_obj .var/cobj "x", TC_dist_class;
    .scope S_dist_main;
T_dist ;
    %new/cobj C_dist_class;
    %store/obj v_dist_obj;
    %load/obj v_dist_obj;
    %pushi/vec4 305419896, 0, 32;
    %srandom;
    %pushi/vec4 512, 0, 32;
T_dist_loop %dup/vec4;
    %cmpi/s 0, 0, 32;
    %jmp/1xz T_dist_done, 5;
    %jmp/1 T_dist_done, 4;
    %subi 1, 0, 32;
    %load/obj v_dist_obj;
    %dup/obj/ref;
    %randomize;
    %pop/obj 1, 0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz T_dist_randomized, 8;
    %vpi_call/w 3 13 "$fatal", 32'sb00000000000000000000000000000001, "UNSAT" {0 0 0 0};
T_dist_randomized ;
    %load/obj v_dist_obj;
    %test_nul/obj;
    %jmp/1 T_dist_null_range, 4;
    %prop/v 0;
    %pop/obj 1, 0;
    %jmp T_dist_have_range;
T_dist_null_range ;
    %pop/obj 1, 0;
    %pushi/vec4 0, 0, 3;
T_dist_have_range ;
    %pad/u 32;
    %cmpi/u 3, 0, 32;
    %flag_or 5, 4;
    %jmp/0xz T_dist_not_range, 5;
    %load/vec4 v_dist_range;
    %pushi/vec4 1, 0, 32;
    %add;
    %cast2;
    %store/vec4 v_dist_range, 0, 32;
    %jmp T_dist_next;
T_dist_not_range ;
    %load/obj v_dist_obj;
    %test_nul/obj;
    %jmp/1 T_dist_null_four, 4;
    %prop/v 0;
    %pop/obj 1, 0;
    %jmp T_dist_have_four;
T_dist_null_four ;
    %pop/obj 1, 0;
    %pushi/vec4 0, 0, 3;
T_dist_have_four ;
    %pad/u 32;
    %cmpi/e 4, 0, 32;
    %jmp/0xz T_dist_escaped, 4;
    %load/vec4 v_dist_four;
    %pushi/vec4 1, 0, 32;
    %add;
    %cast2;
    %store/vec4 v_dist_four, 0, 32;
    %jmp T_dist_next;
T_dist_escaped ;
    %vpi_call/w 3 16 "$fatal", 32'sb00000000000000000000000000000001, "escaped" {0 0 0 0};
T_dist_next ;
    %jmp T_dist_loop;
T_dist_done ;
    %pop/vec4 1;
    %vpi_call/w 3 18 "$display", "range=%0d four=%0d", v_dist_range, v_dist_four {0 0 0 0};
    %end;
    .thread T_dist;
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "dist_unmarked_range_legacy.vvp";
