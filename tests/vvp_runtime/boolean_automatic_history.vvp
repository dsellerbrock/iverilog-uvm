# Exercise the Boolean recv_vec4_pv path directly: retain ancestor writes
# before child allocation, preserve untouched high bits, and reset reused frames.
:ivl_version "13.0 (devel)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "system";
S_top .scope module, "top" "top" 1 1;
 .timescale 0 0;
S_parent .scope autotask, "parent" "parent" 1 1, 1 1 0, S_top;
 .timescale 0 0;
v_input .var/2u "input_value", 1 0;
L_partial .part/pv v_input, 0, 2, 4;
S_child .scope autobegin, "child" "child" 1 1, 1 1 0, S_parent;
 .timescale 0 0;
L_boolean .functor OR 4, L_partial, C4<0000>, C4<0000>, C4<0000>;
v_output .net "output_value", 3 0, L_boolean;
 .scope S_child;
CHILD ;
 %vpi_call/w 1 1 "$display", "BITS %b", v_output {0 0 0 0};
 %pushi/vec4 3, 0, 2;
 %store/vec4 v_input, 0, 2;
 %delay 1, 0;
 %vpi_call/w 1 1 "$display", "BITS %b", v_output {0 0 0 0};
 %end;
 .scope S_parent;
PARENT ;
 %pushi/vec4 3, 0, 2;
 %store/vec4 v_input, 0, 2;
 %pushi/vec4 2, 0, 2;
 %store/vec4 v_input, 0, 2;
 %alloc S_child;
 %fork CHILD, S_child;
 %join;
 %free S_child;
 %end;
 .scope S_top;
T_0 ;
 %alloc S_parent;
 %fork PARENT, S_parent;
 %join;
 %free S_parent;
 %alloc S_parent;
 %fork PARENT, S_parent;
 %join;
 %free S_parent;
 %end;
 .thread T_0;
:file_names 2;
 "N/A";
 "boolean_automatic_history.vvp";
