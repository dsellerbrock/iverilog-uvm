:ivl_version "13.0 (devel)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
S_top .scope module, "top" "top" 1 1;
 .timescale 0 0;
v_orig .array "orig", 1 0, 7 0;
v_alias .array "alias", v_orig;
v_source .var "source", 7 0;
    .scope S_top;
T_0 ;
    %pushi/vec4 18, 0, 8;
    %ix/load 4, 0, 0;
    %flag_set/imm 4, 0;
    %store/vec4a v_orig, 4, 0;
    %pushi/vec4 52, 0, 8;
    %ix/load 4, 1, 0;
    %flag_set/imm 4, 0;
    %store/vec4a v_orig, 4, 0;

    %pushi/vec4 165, 0, 8;
    %store/vec4 v_source, 0, 8;
    %load/vec4 v_source;
    %flag_set/imm 4, 0;
    %ix/load 3, 0, 0;
    %force/vec4/a v_alias, 0;
    %force/link/a v_alias, v_source;
    %delay 0, 0;
    %vpi_call/w 1 1 "$display", "alias-force actual-read=%h", &A<v_orig, 0> {0 0 0 0};

    %pushi/vec4 60, 0, 8;
    %store/vec4 v_source, 0, 8;
    %delay 0, 0;
    %vpi_call/w 1 1 "$display", "alias-live actual-read=%h", &A<v_orig, 0> {0 0 0 0};
    %pushi/vec4 119, 0, 8;
    %ix/load 4, 0, 0;
    %flag_set/imm 4, 0;
    %store/vec4a v_orig, 4, 0;
    %vpi_call/w 1 1 "$display", "actual-write alias-read=%h", &A<v_alias, 0> {0 0 0 0};

    %flag_set/imm 4, 0;
    %ix/load 3, 0, 0;
    %ix/load 4, 8, 0;
    %release/reg/a v_orig, 0, 4;
    %pushi/vec4 240, 0, 8;
    %store/vec4 v_source, 0, 8;
    %delay 0, 0;
    %vpi_call/w 1 1 "$display", "actual-release alias-read=%h", &A<v_alias, 0> {0 0 0 0};
    %pushi/vec4 25, 0, 8;
    %ix/load 4, 0, 0;
    %flag_set/imm 4, 0;
    %store/vec4a v_alias, 4, 0;
    %vpi_call/w 1 1 "$display", "alias-write actual-read=%h", &A<v_orig, 0> {0 0 0 0};

    %pushi/vec4 150, 0, 8;
    %store/vec4 v_source, 0, 8;
    %load/vec4 v_source;
    %flag_set/imm 4, 0;
    %ix/load 3, 1, 0;
    %force/vec4/a v_orig, 0;
    %force/link/a v_orig, v_source;
    %pushi/vec4 71, 0, 8;
    %store/vec4 v_source, 0, 8;
    %delay 0, 0;
    %vpi_call/w 1 1 "$display", "actual-force alias-read=%h", &A<v_alias, 1> {0 0 0 0};
    %pushi/vec4 42, 0, 8;
    %ix/load 4, 1, 0;
    %flag_set/imm 4, 0;
    %store/vec4a v_alias, 4, 0;
    %vpi_call/w 1 1 "$display", "alias-write actual-forced-read=%h", &A<v_orig, 1> {0 0 0 0};

    %flag_set/imm 4, 0;
    %ix/load 3, 1, 0;
    %ix/load 4, 8, 0;
    %release/reg/a v_alias, 0, 4;
    %pushi/vec4 225, 0, 8;
    %store/vec4 v_source, 0, 8;
    %delay 0, 0;
    %vpi_call/w 1 1 "$display", "alias-release actual-read=%h", &A<v_orig, 1> {0 0 0 0};
    %pushi/vec4 109, 0, 8;
    %ix/load 4, 1, 0;
    %flag_set/imm 4, 0;
    %store/vec4a v_orig, 4, 0;
    %vpi_call/w 1 1 "$display", "actual-write alias-read=%h", &A<v_alias, 1> {0 0 0 0};
    %end;
    .thread T_0;
:file_names 2;
    "N/A";
    "force_array_alias.vvp";
