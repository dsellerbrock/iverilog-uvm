:ivl_version "13.0 (devel)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
S_unit .scope package, "$unit" "$unit" 1 1;
 .timescale 0 0;
S_top .scope module, "top" "top" 1 1;
 .timescale 0 0;
    .scope S_top;
T_0 ;
    %pushi/str "x";
    %pushi/vec4 4294967295, 0, 32;
    %concati/vec4 4294967295, 0, 32;
    %ix/vec4 4;
    %rep/str 4;
    %pushi/str "";
    %cmp/str;
    %flag_get/vec4 4;
    %flag_set/vec4 8;
    %jmp/0xz T_fail, 8;
    %pushi/str "x";
    %pushi/vec4 1048576, 0, 32;
    %ix/vec4 4;
    %rep/str 4;
    %pushi/str "";
    %cmp/str;
    %flag_get/vec4 4;
    %flag_set/vec4 8;
    %jmp/0xz T_fail, 8;
    %pushi/str "x";
    %pushi/vec4 3, 0, 32;
    %ix/vec4 4;
    %rep/str 4;
    %pushi/str "xxx";
    %cmp/str;
    %flag_get/vec4 4;
    %flag_set/vec4 8;
    %jmp/0xz T_fail, 8;
    %vpi_call/w 1 1 "$display", "PASSED" {0 0 0 0};
    %jmp T_end;
T_fail ;
    %vpi_call/w 1 2 "$display", "FAILED" {0 0 0 0};
T_end ;
    %end;
    .thread T_0;
:file_names 2;
    "N/A";
    "tests/vvp_runtime/string_repeat_legacy.vvp";
