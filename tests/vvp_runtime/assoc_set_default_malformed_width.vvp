:ivl_version "13.0 (devel)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
S_unit .scope package, "$unit" "$unit" 1 1;
 .timescale 0 0;
S_top .scope module, "top" "top" 1 1;
 .timescale 0 0;
    .scope S_top;
T_0 ;
    %new/queue "@4";
    %pushi/vec4 1, 0, 1;
    %aa/set/default/v 8;
    %pop/vec4 1;
    %pop/obj 1, 0;
    %end;
    .thread T_0;
:file_names 2;
    "N/A";
    "assoc_set_default_malformed_width.vvp";
