:ivl_version "13.0 (devel)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
S_top .scope module, "top" "top" 1 1;
 .timescale 0 0;
E_0 .event "event";
    .scope S_top;
T_wait ;
    %wait/obj/expr E_0, T_recipe;
    %end;
T_recipe ;
    %pushi/vec4 0, 0, 1;
    %event/expr/load/o 0;
    %event/expr/return 0;
    .thread T_wait;
:file_names 2;
    "N/A";
    "mixed_wait_recipe_zero_object.vvp";
