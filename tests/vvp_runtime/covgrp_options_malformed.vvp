:ivl_version "13.0 (devel)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
S_unit .scope package, "$unit" "$unit" 1 1;
 .timescale 0 0;
S_top .scope module, "top" "top" 1 1;
 .timescale 0 0;
C0x1 .class "plain" "top.plain" [0]
 ;
    .scope S_top;
T_0 ;
    %covgrp/options/init;
    %end;
    .thread T_0;
T_1 ;
    %null;
    %covgrp/options/init;
    %pop/obj 1, 0;
    %end;
    .thread T_1;
T_2 ;
    %new/cobj C0x1;
    %covgrp/options/init;
    %pop/obj 1, 0;
    %end;
    .thread T_2;
:file_names 2;
    "N/A";
    "covgrp_options_malformed.vvp";
