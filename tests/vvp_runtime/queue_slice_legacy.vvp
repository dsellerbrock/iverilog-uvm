:ivl_version "13.0 (devel)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
S_unit .scope package, "$unit" "$unit" 1 1;
 .timescale 0 0;
S_top .scope module, "top" "top" 1 1;
 .timescale 0 0;
v_q .var/queue "q", 32+, "Qv";
v_r .var/queue "r", 32+, "Qv";
    .scope S_top;
T_0 ;
    %ix/load 4, 0, 0;
    %new/queue "sb32";
    %dup/obj/ref;
    %pushi/vec4 10, 0, 32;
    %store/qo/b/v 32;
    %dup/obj/ref;
    %pushi/vec4 20, 0, 32;
    %store/qo/b/v 32;
    %dup/obj/ref;
    %pushi/vec4 30, 0, 32;
    %store/qo/b/v 32;
    %dup/obj/ref;
    %pushi/vec4 40, 0, 32;
    %store/qo/b/v 32;
    %store/qobj/v v_q, 4, 32;
    %ix/load 4, 0, 0;
    %load/obj v_q;
    %pushi/vec4 1, 0, 32;
    %pushi/vec4 2, 0, 32;
    %qslice;
    %store/qobj/v v_r, 4, 32;
    %qsize v_r;
    %cmpi/ne 2, 0, 32;
    %jmp/1 T_bad, 4;
    %flag_mov 8, 4;
    %ix/load 3, 0, 0;
    %flag_set/imm 4, 0;
    %load/dar/vec4 v_r;
    %cast2;
    %cmpi/ne 20, 0, 32;
    %flag_or 4, 8;
    %jmp/1 T_bad, 4;
    %flag_mov 8, 4;
    %ix/load 3, 1, 0;
    %flag_set/imm 4, 0;
    %load/dar/vec4 v_r;
    %cast2;
    %cmpi/ne 30, 0, 32;
    %flag_or 4, 8;
    %jmp/0xz T_next, 4;
T_bad ;
    %vpi_call/w 1 1 "$fatal", 32'sb00000000000000000000000000000001, "legacy qslice failed: %p", v_r {0 0 0 0};
T_next ;
    %ix/load 4, 0, 0;
    %load/obj v_q;
    %pushi/vec4 1, 0, 32;
    %qslice/last;
    %store/qobj/v v_r, 4, 32;
    %qsize v_r;
    %cmpi/ne 3, 0, 32;
    %jmp/1 T_bad, 4;
    %ix/load 3, 0, 0;
    %flag_set/imm 4, 0;
    %load/dar/vec4 v_r;
    %cast2;
    %cmpi/ne 20, 0, 32;
    %jmp/1 T_bad, 4;
    %ix/load 3, 2, 0;
    %flag_set/imm 4, 0;
    %load/dar/vec4 v_r;
    %cast2;
    %cmpi/ne 40, 0, 32;
    %jmp/1 T_bad, 4;
    %ix/load 4, 0, 0;
    %load/obj v_q;
    %pushi/vec4 0, 0, 32;
    %pushi/vec4 1, 0, 32;
    %qslice/off;
    %store/qobj/v v_r, 4, 32;
    %qsize v_r;
    %cmpi/ne 3, 0, 32;
    %jmp/1 T_bad, 4;
    %ix/load 3, 0, 0;
    %flag_set/imm 4, 0;
    %load/dar/vec4 v_r;
    %cast2;
    %cmpi/ne 10, 0, 32;
    %jmp/1 T_bad, 4;
    %ix/load 3, 2, 0;
    %flag_set/imm 4, 0;
    %load/dar/vec4 v_r;
    %cast2;
    %cmpi/ne 30, 0, 32;
    %jmp/1 T_bad, 4;
T_good ;
    %vpi_call/w 1 2 "$display", "PASSED" {0 0 0 0};
    %end;
    .thread T_0;
:file_names 2;
    "N/A";
    "tests/vvp_runtime/queue_slice_legacy.vvp";
