:ivl_version "13.0 (devel)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
S_top .scope module, "top" "top" 1 1;
 .timescale 0 0;
v_dst .array/2s "dst", 0 3, 7 0;
v_copy .array/2s "copy", 0 3, 7 0;
    .scope S_top;
T_0 ;
    %pushi/vec4 17, 0, 8;
    %ix/load 4, 0, 0;
    %flag_set/imm 4, 0;
    %store/vec4a v_dst, 4, 0;
    %pushi/vec4 34, 0, 8;
    %ix/load 4, 1, 0;
    %flag_set/imm 4, 0;
    %store/vec4a v_dst, 4, 0;
    %pushi/vec4 51, 0, 8;
    %ix/load 4, 2, 0;
    %flag_set/imm 4, 0;
    %store/vec4a v_dst, 4, 0;
    %pushi/vec4 68, 0, 8;
    %ix/load 4, 3, 0;
    %flag_set/imm 4, 0;
    %store/vec4a v_dst, 4, 0;

    ; A hand-written valid image pins the new textual VVP instruction forms.
    %slice/push 1, 2;
    %load/arr/dar/slice v_dst, 264, 1;
    %slice/push 1, 2;
    %store/arr/dar/slice v_copy, 264;

    ; Both consumers must recover safely when no descriptor is present.
    %load/arr/dar/slice v_dst, 264, 0;
    %pop/obj 1, 0;
    %null;
    %store/arr/dar/slice v_dst, 264;

    ; An invalid storage window is diagnosed before any element access.
    %slice/push 3, 2;
    %load/arr/dar/slice v_dst, 264, 3;
    %pop/obj 1, 0;
    %ix/load 0, 2, 0;
    %new/darray 0, "sb8";
    %slice/push 3, 2;
    %store/arr/dar/slice v_dst, 264;

    ; A short source must not partially overwrite a valid destination window.
    %ix/load 0, 2, 0;
    %new/darray 0, "sb8";
    %slice/push 0, 3;
    %store/arr/dar/slice v_dst, 264;

    %vpi_call/w 1 1 "$display", "slice-ir dst=%02h,%02h,%02h,%02h copy=%02h,%02h,%02h,%02h", &A<v_dst, 0>, &A<v_dst, 1>, &A<v_dst, 2>, &A<v_dst, 3>, &A<v_copy, 0>, &A<v_copy, 1>, &A<v_copy, 2>, &A<v_copy, 3> {0 0 0 0};
    %end;
    .thread T_0;
:file_names 2;
    "N/A";
    "array_slice_marshal_malformed.vvp";
