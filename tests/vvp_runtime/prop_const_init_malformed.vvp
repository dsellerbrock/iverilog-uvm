:ivl_version "13.0 (devel)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
S_unit .scope package, "$unit" "$unit" 1 1;
 .timescale 0 0;
S_top .scope module, "top" "top" 1 1;
 .timescale 0 0;
    .scope S_top;
T_0 ;
    %file_line 1 7 "Instance constant initialization guard.";
    %prop/const/init 0;
    %end;
    .thread T_0;
:file_names 2;
    "N/A";
    "prop_const_init_malformed.vvp";
