+/* Native-code spike: the mnemonic of an instruction, for checking that a
+   generated library's instruction numbering matches the loaded code. */
+extern "C" const char* vvp_native_opname(vvp_code_t c)
+{
+      for (const opcode_table_s*op = opcode_table ; op->mnemonic ; op += 1)
+	    if (op->opcode == c->opcode)
+		  return op->mnemonic;
+      return "?";
+}
 static const unsigned opcode_count =
                     sizeof(opcode_table)/sizeof(*opcode_table) - 1;
 
