--- a/src/sha512/rtl/sha512.sv
+++ b/src/sha512/rtl/sha512.sv
@@ -536,6 +536,34 @@
 `CALIPTRA_ASSERT_STABLE(ERR_SHA_KEY_RD_CTRL_NOT_STABLE, kv_read_ctrl_reg, clk, (!reset_n || ready_reg) )
 `CALIPTRA_ASSERT_STABLE(ERR_SHA_WR_CTRL_NOT_STABLE, kv_write_ctrl_reg, clk, (!reset_n || ready_reg) )
 // Each word can be refilled while the core works on a previously captured block.
+// Diagnostic only: report the exact register controls sampled before a busy block change.
+for (genvar trace_word = 0; trace_word < BLOCK_NUM_DWORDS; trace_word++) begin : gen_block_trace
+  reg [DATA_WIDTH-1:0] sampled_block, sampled_next, sampled_combo_next;
+  reg sampled_valid, sampled_ready, sampled_we, sampled_hwclr, sampled_sw_write;
+  always @(posedge clk or negedge reset_n) begin
+    if (!reset_n) begin
+      sampled_valid <= 1'b0;
+    end else begin
+      if (sampled_valid && !ready_reg && !sampled_ready &&
+          block_reg[trace_word] !== sampled_block)
+        $display("SHA_BLOCK_OBS time=%0t word=%0d old=%08h now=%08h we=%b next=%08h hwclr=%b sw=%b combo_next=%08h",
+                 $time, trace_word, sampled_block, block_reg[trace_word],
+                 sampled_we, sampled_next, sampled_hwclr, sampled_sw_write,
+                 sampled_combo_next);
+      sampled_valid <= 1'b1;
+      sampled_ready <= ready_reg;
+      sampled_block <= block_reg[trace_word];
+      sampled_we <= hwif_in.SHA512_BLOCK[trace_word].BLOCK.we;
+      sampled_next <= hwif_in.SHA512_BLOCK[trace_word].BLOCK.next;
+      sampled_hwclr <= hwif_in.SHA512_BLOCK[trace_word].BLOCK.hwclr;
+      sampled_sw_write <= i_sha512_reg.decoded_reg_strb.SHA512_BLOCK[trace_word] &&
+                          i_sha512_reg.decoded_req_is_wr &&
+                          !hwif_in.SHA512_BLOCK[trace_word].BLOCK.swwel;
+      sampled_combo_next <= i_sha512_reg.field_combo.SHA512_BLOCK[trace_word].BLOCK.next;
+    end
+  end
+end
